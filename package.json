{
  "name": "swiftdrop",
  "version": "1.0.0",
  "private": true,
  "description": "Peer-to-peer browser file transfer",
  "workspaces": [
    "Backend",
    "Frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -n signaling,web \"npm run start --workspace backend\" \"npm run dev --workspace frontend -- --host 0.0.0.0\"",
    "build": "npm run build --workspace frontend",
    "lint": "npm run lint --workspace frontend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
