NODE_ENV=production
CORS_ORIGIN=https://your-frontend-domain.vercel.app
# Metered TURN option: use the Metered app HTTPS origin and credential-scoped TURN API key.
# METERED_DOMAIN=https://your-app.metered.live
# METERED_TURN_API_KEY=keep-this-server-side
# Optional Coturn REST API settings. Keep the shared secret only on the backend.
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
# TURN_SHARED_SECRET=replace-with-the-coturn-static-auth-secret
# TURN_CREDENTIAL_TTL_SECONDS=3600
